# Required for the default cloud-first MVP:
DADATA_TOKEN=
DADATA_SECRET=
ORS_API_KEY=

# Optional local routing:
OSRM_URL=http://127.0.0.1:5000

# Optional LLM address adjudication:
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# App defaults:
GEOCODER=dadata
ROUTER=ors
DB_PATH=data/cache/courier-router.db
DEPART_TIME=10:00
END_MODE=depot
DEFAULT_SERVICE_MIN=10
SOLVER_TIME_LIMIT_SEC=8

# Fixed depot. Run `courier-route geocode-depot` once and replace these
# if you want to pin manually verified coordinates.
DEPOT_ADDRESS=ул Костюшко, д 2, Санкт-Петербург
DEPOT_LAT=
DEPOT_LON=

# Tile rendering (OpenStreetMap standard tiles; small interactive-like usage only)
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_USER_AGENT=courier-router/0.2 (+private internal route planner)

# Authenticated web UI:
# Generate once with: openssl rand -hex 32
WEB_SESSION_SECRET=
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_HTTPS_ONLY=1
WEB_USERS_PATH=data/web/users.json
WEB_RUNS_PATH=data/web/runs
WEB_MAX_UPLOAD_MB=10
